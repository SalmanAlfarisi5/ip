<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- A BorderPane rather than fixed anchors, so the conversation takes whatever
     room the window has and the input row stretches with it on resize. -->
<BorderPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sallman.gui.MainWindow">
    <center>
        <!-- Not focus-traversable, so typing goes straight to the input box. -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    focusTraversable="false"
                    hbarPolicy="NEVER"
                    vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="4.0">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="8.0" styleClass="input-bar">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type a command, e.g. todo read book"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        minWidth="-Infinity"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
    </bottom>
    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>
</BorderPane>
